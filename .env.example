# Copy this file to `.env` and fill in your API key.
# NEVER commit the actual .env file (it is in .gitignore).
#
# Priority: AI_API_KEY > OPENAI_API_KEY
AI_API_KEY=sk-your-key-here

# Optional generator overrides.
# Precedence: CLI flags > these variables > .ai_context.toml > built-in defaults.
# AI_CONTEXT_MODEL=deepseek-chat
# AI_CONTEXT_BASE_URL=https://api.deepseek.com
# AI_CONTEXT_LANGUAGE=english

# Output control (both are standard, tool-agnostic conventions).
# NO_COLOR=1      # disable ANSI colour entirely
# FORCE_COLOR=1   # keep colour even when stdout is not a terminal
